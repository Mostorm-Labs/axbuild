{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mostorm-Labs/axbuild/schemas/sdk-lock-v1.schema.json",
  "title": "AxBuild SDK Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "family", "repository", "releaseTag", "releaseSetId", "indexAsset", "indexSha256"],
  "properties": {
    "format": {"const": "axbuild-sdk-lock-v1"},
    "family": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "releaseTag": {"type": "string", "minLength": 1},
    "releaseSetId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "indexAsset": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\\\u0000]+$"},
    "indexSha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
  }
}
