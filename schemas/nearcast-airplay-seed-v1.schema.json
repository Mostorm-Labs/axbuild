{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mostorm-Labs/axbuild/schemas/nearcast-airplay-seed-v1.schema.json",
  "title": "AxBuild NearCast AirPlay Seed Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "family", "target", "variant", "artifacts", "provenance", "lock"],
  "properties": {
    "format": {"const": "axbuild-nearcast-airplay-seed-v1"},
    "family": {"const": "nearcast-airplay"},
    "target": {"const": "windows-x64"},
    "variant": {"const": "release"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "artifact-manifest-v1.schema.json#/$defs/artifact"}
    },
    "provenance": {"type": "string", "pattern": "^[^/\\\\\\u0000]+$"},
    "lock": {"type": "string", "pattern": "^[^/\\\\\\u0000]+$"}
  }
}
