{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mostorm-Labs/axbuild/schemas/nearcast-airplay-qualification-report-v1.schema.json",
  "title": "AxBuild NearCast AirPlay Qualification Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "artifactIdentity", "artifactSha256", "validationResults", "timestamp", "toolVersion"],
  "properties": {
    "format": {"const": "axbuild-nearcast-airplay-qualification-report-v1"},
    "artifactIdentity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "artifactSha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "validationResults": {"type": "object", "minProperties": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "toolVersion": {"type": "string", "minLength": 1}
  }
}
